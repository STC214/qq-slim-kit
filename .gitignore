# Local SDK/tooling, signing material and machine configuration
.local/
.gradle/
**/build/
local.properties
*.jks
*.keystore
*.keystore.lock
keystore.properties
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
*.iml
.vscode/
Thumbs.db
.DS_Store
desktop.ini

