*.apk
*.aab
*.apksig
*.idsig
*.class
*.dex
*.jar
*.log
*.tmp
*.new
__pycache__/
*.py[cod]

# Unrelated local device helper
/rollback-cx-network.ps1

# Raw tool transcripts are local; the curated review report is kept in Git.
/artifacts/review/*.txt
/artifacts/review/*.json
/artifacts/review/*.png
/artifacts/review/*.xml
